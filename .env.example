# Sportradar Soccer API (https://developer.sportradar.com/soccer/reference/soccer-api-overview)
# Server-side only — never expose this to the browser or prefix it with NEXT_PUBLIC_.
SPORTRADAR_SOCCER_API_KEY=

# "trial" or "production" — matches the access level Sportradar issued your key for.
# Trial keys are typically rate-limited to ~1 request/second.
SPORTRADAR_ACCESS_LEVEL=trial

# Response language code Sportradar should return (default: en).
SPORTRADAR_LANGUAGE=en

# Odds Comparison Regular API. Optional — falls back to the key above, which
# is correct for a master key covering every product.
SPORTRADAR_ODDS_API_KEY=

# Odds Comparison URL segment. "oddscomparison-rg" is the Regular product;
# change it if your account is provisioned under a different variant.
SPORTRADAR_ODDS_BASE=oddscomparison-rg

# Odds Comparison version line. The Odds family is documented under v1,
# separate from the v4 soccer feeds. GET /api/odds/health?probe=1 reports
# which base/version/access-level combination your key actually opens.
SPORTRADAR_ODDS_VERSION=v1
