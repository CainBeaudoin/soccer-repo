# Sportradar Soccer API (https://developer.sportradar.com/soccer/reference/soccer-api-overview)
# Server-side only — never expose this to the browser or prefix it with NEXT_PUBLIC_.
SPORTRADAR_SOCCER_API_KEY=

# "trial" or "production" — matches the access level Sportradar issued your key for.
# Trial keys are typically rate-limited to ~1 request/second.
SPORTRADAR_ACCESS_LEVEL=trial

# Response language code Sportradar should return (default: en).
SPORTRADAR_LANGUAGE=en
